/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: fullscreen=(self), gamepad=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://cdn.jsdelivr.net https://raw.githubusercontent.com https://dl.polyhaven.org; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Cache-Control: public, max-age=300

/js/*
  Cache-Control: public, max-age=86400

/css/*
  Cache-Control: public, max-age=86400

/sounds/*
  Cache-Control: public, max-age=604800

/env/*
  Cache-Control: public, max-age=604800
